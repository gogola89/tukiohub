								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"organizer@example.com\",\n  \"password\": \"organizer123\",\n  \"password_confirm\": \"organizer123\",\n  \"phone_number\": \"+254700000001\",\n  \"company_name\": \"Event Organizers Ltd\",\n  \"role\": \"ORGANIZER\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register/",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "register", ""]
						}
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"pm.collectionVariables.set(\"access_token\", jsonData.access);",
									"pm.collectionVariables.set(\"refresh_token\", jsonData.refresh);"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
